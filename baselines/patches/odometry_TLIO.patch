+#!/usr/bin/env python3
+"""TLIO's ResNet1D on Nymeria wrist IMU under the benchmark's WRIST-FRAME odometry protocol.
+
+Same network, optimiser, schedule and best-epoch rule as train_nymeria_tlio.py (the world-frame variant);
+only the target frame and the scorer change. TLIO's network emits ONE 3-vector per window: in the world-frame
+variant that is the window's net displacement, scored as a constant-velocity trajectory. Its wrist-frame
+counterpart is the window-mean pelvis velocity expressed in the wrist (FLU) frame, held constant over the
+benchmark's 8 x 4 sub-step grid and scored by the benchmark's own reconstruct_batch (common_local_eval.py).
+"""
+import argparse, os, sys
+import numpy as np
+import torch
+import torch.nn as nn
+
+_THIS = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, _THIS); sys.path.insert(0, os.path.dirname(_THIS))
+from train_nymeria_tlio import load_resnet1d_classes, infer_inter_dim      # noqa: E402
+from common_local_eval import score, write_result                           # noqa: E402
+
+
+def predict(model, X, device, bs=1024):
+    model.eval(); out = []
+    with torch.no_grad():
+        for i in range(0, len(X), bs):
+            out.append(model(torch.from_numpy(X[i:i + bs]).to(device))[0].cpu().numpy())
+    v = np.concatenate(out)                                   # [N, 3] window-mean wrist-frame velocity
+    return np.broadcast_to(v[:, None, None, :], (len(v), 8, 4, 3)).astype(np.float32).copy()
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    p.add_argument("--cache-dir", default=os.path.join(os.path.dirname(_THIS), "data_cache"))
+    p.add_argument("--out-dir", default=os.path.join(_THIS, "runs_nymeria_local"))
+    p.add_argument("--epochs", type=int, default=100); p.add_argument("--patience", type=int, default=15)
+    p.add_argument("--batch-size", type=int, default=512); p.add_argument("--lr", type=float, default=1e-3)
+    p.add_argument("--weight-decay", type=float, default=1e-4)
+    a = p.parse_args()
+    os.makedirs(a.out_dir, exist_ok=True)
+    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
+    tr = np.load(os.path.join(a.cache_dir, "nymeria_local_train.npz")); va = dict(np.load(os.path.join(a.cache_dir, "nymeria_local_val.npz")))
+    X_tr, y_tr = tr["X"], tr["Y"].mean(axis=(1, 2)).astype(np.float32)
+    print(f"train windows={len(X_tr)}  val windows={len(va['X'])}", flush=True)
+    ResNet1D, Block = load_resnet1d_classes()
+    model = ResNet1D(Block, 6, 3, [2, 2, 2, 2], infer_inter_dim(ResNet1D, Block, X_tr.shape[-1])).to(device)
+    opt = torch.optim.AdamW(model.parameters(), lr=a.lr, weight_decay=a.weight_decay)
+    sched = torch.optim.lr_scheduler.CosineAnnealingLR(opt, T_max=a.epochs); mse = nn.MSELoss()
+    best, best_m, no_imp, n = float("inf"), None, 0, len(X_tr)
+    for ep in range(a.epochs):
+        model.train(); perm = np.random.permutation(n); tot = 0.0
+        for i in range(0, n, a.batch_size):
+            idx = np.sort(perm[i:i + a.batch_size])
+            xb, yb = torch.from_numpy(X_tr[idx]).to(device), torch.from_numpy(y_tr[idx]).to(device)
+            opt.zero_grad(); loss = mse(model(xb)[0], yb); loss.backward()
+            torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0); opt.step(); tot += loss.item() * len(idx)
+        sched.step(); m = score(predict(model, va["X"], device), va)
+        imp = m["ate_m"] < best - 1e-6
+        if imp:
+            best, best_m, no_imp = m["ate_m"], m, 0; torch.save(model.state_dict(), os.path.join(a.out_dir, "best.pt"))
+        else:
+            no_imp += 1
+        print(f"epoch {ep + 1:3d}/{a.epochs} train_loss={tot / n:.5f} val ATE={m['ate_m']:.4f} drift={m['drift_pct']:.2f}% best={best:.4f} {'*' if imp else ''}", flush=True)
+        if no_imp >= a.patience:
+            break
+    write_result("tlio", best_m, {"script": "TLIO/train_nymeria_tlio_local.py", "epochs_run": ep + 1, "n_val_windows": int(len(va["X"])),
+                                  "n_train_windows": int(n), "output": "window-mean wrist-frame velocity, constant over the 8x4 grid"},
+                 "TLIO's ResNet1D trained on the benchmark's Nymeria training windows to predict the window-mean pelvis velocity in the "
+                 "wrist frame, scored by the benchmark's wrist-frame reconstruction (same windows and scorer as every other row).")
+
+
+if __name__ == "__main__":
+    main()
