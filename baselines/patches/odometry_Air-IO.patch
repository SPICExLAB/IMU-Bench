+#!/usr/bin/env python3
+"""Air-IO's CodeNetMotion on Nymeria wrist IMU under the benchmark's WRIST-FRAME odometry protocol.
+
+Air-IO regresses body-frame velocity by design, so this is its native target: the same network, optimiser,
+schedule and best-epoch rule as train_nymeria_airio.py, trained on per-sample pelvis velocity in the wrist (FLU)
+frame (the benchmark's 8 x 4 sub-step targets, each held for its 4 samples, aligned with the network's own
+get_label()). Its ~15-step output is mapped onto the benchmark's 32 sub-steps by nearest time and scored by the
+benchmark's own reconstruct_batch (common_local_eval.py).
+"""
+import argparse, os, sys
+from types import SimpleNamespace
+import numpy as np
+import torch
+import torch.nn as nn
+
+_THIS = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, _THIS); sys.path.insert(0, os.path.dirname(_THIS))
+from train_nymeria_airio import load_codenet_motion_class, to_acc_gyro      # noqa: E402
+from common_local_eval import score, write_result                            # noqa: E402
+
+
+def predict(model, X, device, bs=1024):
+    model.eval(); out = []
+    with torch.no_grad():
+        for i in range(0, len(X), bs):
+            out.append(model(to_acc_gyro(torch.from_numpy(X[i:i + bs]).to(device)))["net_vel"].cpu().numpy())
+    v = np.concatenate(out)                                                 # [N, L, 3]
+    L = v.shape[1]
+    idx = np.clip(np.floor((np.arange(32) + 0.5) / 32 * L).astype(int), 0, L - 1)   # sub-step centre -> nearest output step
+    return v[:, idx].reshape(len(v), 8, 4, 3).astype(np.float32)
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    p.add_argument("--cache-dir", default=os.path.join(os.path.dirname(_THIS), "data_cache"))
+    p.add_argument("--out-dir", default=os.path.join(_THIS, "runs_nymeria_local"))
+    p.add_argument("--epochs", type=int, default=80); p.add_argument("--patience", type=int, default=10)
+    p.add_argument("--batch-size", type=int, default=512); p.add_argument("--lr", type=float, default=1e-3)
+    p.add_argument("--weight-decay", type=float, default=1e-4)
+    a = p.parse_args()
+    os.makedirs(a.out_dir, exist_ok=True)
+    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
+    tr = np.load(os.path.join(a.cache_dir, "nymeria_local_train.npz")); va = dict(np.load(os.path.join(a.cache_dir, "nymeria_local_val.npz")))
+    X_tr = tr["X"]; T = X_tr.shape[-1]
+    vel_tr = np.repeat(tr["Y"].reshape(len(X_tr), 32, 3), T // 32, axis=1).astype(np.float32)      # [N, 128, 3] per-sample label
+    print(f"train windows={len(X_tr)}  val windows={len(va['X'])}", flush=True)
+    model = load_codenet_motion_class()(SimpleNamespace(propcov=False)).to(device)
+    opt = torch.optim.AdamW(model.parameters(), lr=a.lr, weight_decay=a.weight_decay)
+    sched = torch.optim.lr_scheduler.CosineAnnealingLR(opt, T_max=a.epochs); mse = nn.MSELoss()
+    best, best_m, no_imp, n = float("inf"), None, 0, len(X_tr)
+    for ep in range(a.epochs):
+        model.train(); perm = np.random.permutation(n); tot = 0.0
+        for i in range(0, n, a.batch_size):
+            idx = np.sort(perm[i:i + a.batch_size])
+            xb, gt = torch.from_numpy(X_tr[idx]).to(device), torch.from_numpy(vel_tr[idx]).to(device)
+            opt.zero_grad(); out = model(to_acc_gyro(xb)); loss = mse(out["net_vel"], model.get_label(gt)); loss.backward()
+            torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0); opt.step(); tot += loss.item() * len(idx)
+        sched.step(); m = score(predict(model, va["X"], device), va)
+        imp = m["ate_m"] < best - 1e-6
+        if imp:
+            best, best_m, no_imp = m["ate_m"], m, 0; torch.save(model.state_dict(), os.path.join(a.out_dir, "best.pt"))
+        else:
+            no_imp += 1
+        print(f"epoch {ep + 1:3d}/{a.epochs} train_loss={tot / n:.5f} val ATE={m['ate_m']:.4f} drift={m['drift_pct']:.2f}% best={best:.4f} {'*' if imp else ''}", flush=True)
+        if no_imp >= a.patience:
+            break
+    write_result("airio", best_m, {"script": "Air-IO/train_nymeria_airio_local.py", "epochs_run": ep + 1, "n_val_windows": int(len(va["X"])),
+                                   "n_train_windows": int(n), "output": "per-step wrist-frame velocity, nearest-time mapped to the 8x4 grid"},
+                 "Air-IO's CodeNetMotion trained on the benchmark's Nymeria training windows to predict pelvis velocity in the wrist "
+                 "frame (its native body-frame target), scored by the benchmark's wrist-frame reconstruction.")
+
+
+if __name__ == "__main__":
+    main()
