+#!/usr/bin/env python3
+"""Train + evaluate Air-IO's CodeNetMotion velocity-sequence network on
+Nymeria wrist IMU -> world-frame pelvis odometry, scored in the exact metric
+definition of "4b. Odometry -- canonical world-frame variant".
+
+Adaptation notes (documented, not hidden)
+------------------------------------------
+* Reuses Air-IO's actual network (``model/code.py::CodeNetMotion``, the real
+  learned component) loaded directly from its source file.
+* Air-IO's own training pipeline (``train_motion.py``) uses pypose Lie-group
+  ground-truth rotation labels, a HOCON config system, wandb logging, and its
+  own ``SeqeuncesMotionDataset``/hdf5 data format. None of that is
+  reproduced here -- this script trains the SAME architecture (with
+  ``conf.propcov=False``, i.e. no covariance branch/loss -- this benchmark
+  doesn't do EKF fusion for any baseline, see the TLIO adapter's docstring
+  for the same reasoning) with plain MSE regression against per-sample
+  instantaneous velocity, using the network's own ``get_label()`` utility to
+  align targets to its native output stride (no rotation input used, i.e.
+  the base ``CodeNetMotion``, not ``CodeNetMotionwithRot`` -- this benchmark
+  has no pelvis orientation ground truth, only position, matching every
+  other model here).
+* CodeNetMotion naturally outputs a short PER-STEP velocity sequence (~15
+  steps for a 128-sample/2.56s window, set by its conv strides), closer to
+  "Ours"'s 32-segment resolution than TLIO's single displacement. The
+  resulting piecewise-constant-velocity trajectory is interpolated onto the
+  same 33-point grid "Ours" is scored on -- see ../common_worldframe_eval.py.
+"""
+from __future__ import annotations
+
+import argparse
+import csv
+import importlib.util
+import os
+import sys
+from types import SimpleNamespace
+
+import numpy as np
+import torch
+import torch.nn as nn
+
+_THIS_DIR = os.path.dirname(os.path.abspath(__file__))
+_ODOM_DIR = os.path.dirname(_THIS_DIR)
+sys.path.insert(0, _ODOM_DIR)
+from common_worldframe_eval import score_window, aggregate  # noqa: E402
+
+
+def load_codenet_motion_class():
+    spec = importlib.util.spec_from_file_location(
+        "airio_code", os.path.join(_THIS_DIR, "model", "code.py")
+    )
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    return mod.CodeNetMotion
+
+
+def to_acc_gyro(X):
+    """X: [B,6,T] (acc_F,acc_L,acc_U,gyro_F,gyro_L,gyro_U) channels-first ->
+    data dict with acc/gyro each [B,T,3] channels-last, as CodeNetMotion expects."""
+    acc = X[:, :3, :].transpose(1, 2)
+    gyro = X[:, 3:, :].transpose(1, 2)
+    return {"acc": acc, "gyro": gyro}
+
+
+def native_velocity_labels(POS):
+    """POS: [N, T+1, 3] native-resolution position -> [N, T, 3] per-sample
+    instantaneous velocity (forward difference at 50Hz), the format
+    CodeNetMotion.get_label() expects (same length as the input sequence)."""
+    dt = 1.0 / 50.0  # native cache resolution; overridden by --target-hz if needed
+    return np.diff(POS, axis=1) / dt
+
+
+def evaluate(model, X, POS, device, window_seconds, batch_size=512):
+    model.eval()
+    vel_mses, ates, ferrs, plens = [], [], [], []
+    with torch.no_grad():
+        for i in range(0, len(X), batch_size):
+            xb = torch.from_numpy(X[i:i + batch_size]).to(device)
+            data = to_acc_gyro(xb)
+            out = model(data)
+            net_vel = out["net_vel"].cpu().numpy()  # [b, L_out, 3]
+            L_out = net_vel.shape[1]
+            dt_step = window_seconds / L_out
+            for j in range(net_vel.shape[0]):
+                traj_pred = np.zeros((L_out + 1, 3), dtype=np.float64)
+                traj_pred[1:] = np.cumsum(net_vel[j].astype(np.float64) * dt_step, axis=0)
+                vel_mse, ate, ferr, plen = score_window(traj_pred, POS[i + j], window_seconds)
+                vel_mses.append(vel_mse); ates.append(ate); ferrs.append(ferr); plens.append(plen)
+    return aggregate(vel_mses, ates, ferrs, plens)
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument("--cache-dir", default=os.path.join(_ODOM_DIR, "data_cache"))
+    p.add_argument("--out-dir", default=os.path.join(_THIS_DIR, "runs_nymeria"))
+    p.add_argument("--epochs", type=int, default=80)
+    p.add_argument("--patience", type=int, default=10)
+    p.add_argument("--batch-size", type=int, default=512)
+    p.add_argument("--lr", type=float, default=1e-3)
+    p.add_argument("--weight-decay", type=float, default=1e-4)
+    p.add_argument("--device", default="cuda" if torch.cuda.is_available() else "cpu")
+    args = p.parse_args()
+
+    os.makedirs(args.out_dir, exist_ok=True)
+    device = torch.device(args.device)
+
+    tr = np.load(os.path.join(args.cache_dir, "nymeria_worldframe_train.npz"))
+    va = np.load(os.path.join(args.cache_dir, "nymeria_worldframe_val.npz"))
+    X_tr, POS_tr = tr["X"], tr["POS"]
+    X_va, POS_va = va["X"], va["POS"]
+    window_seconds = float(tr["window_seconds"])
+    target_hz = float(tr["target_hz"])
+    T = X_tr.shape[-1]
+    print(f"train windows={len(X_tr)}  val windows={len(X_va)}  T={T}  window_seconds={window_seconds}")
+
+    CodeNetMotion = load_codenet_motion_class()
+    conf = SimpleNamespace(propcov=False)
+    model = CodeNetMotion(conf).to(device)
+    print(f"params: {sum(p.numel() for p in model.parameters()):,}")
+
+    dt_native = 1.0 / target_hz
+    vel_gt_tr = (np.diff(POS_tr, axis=1) / dt_native).astype(np.float32)  # [N,T,3]
+
+    opt = torch.optim.AdamW(model.parameters(), lr=args.lr, weight_decay=args.weight_decay)
+    sched = torch.optim.lr_scheduler.CosineAnnealingLR(opt, T_max=args.epochs)
+    mse = nn.MSELoss()
+
+    n = len(X_tr)
+    best_ate, best_state, no_imp = float("inf"), None, 0
+    for ep in range(args.epochs):
+        model.train()
+        perm = np.random.permutation(n)
+        ep_loss = 0.0
+        for i in range(0, n, args.batch_size):
+            idx = perm[i:i + args.batch_size]
+            xb = torch.from_numpy(X_tr[idx]).to(device)
+            gt_label = torch.from_numpy(vel_gt_tr[idx]).to(device)
+            opt.zero_grad()
+            data = to_acc_gyro(xb)
+            out = model(data)
+            aligned = model.get_label(gt_label)
+            loss = mse(out["net_vel"], aligned)
+            loss.backward()
+            torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)
+            opt.step()
+            ep_loss += loss.item() * len(idx)
+        sched.step()
+        ep_loss /= n
+
+        m = evaluate(model, X_va, POS_va, device, window_seconds, batch_size=args.batch_size)
+        improved = m["ate"] < best_ate - 1e-6
+        if improved:
+            best_ate = m["ate"]
+            best_state = {k: v.detach().cpu().clone() for k, v in model.state_dict().items()}
+            no_imp = 0
+        else:
+            no_imp += 1
+        print(f"epoch {ep+1:3d}/{args.epochs}  train_loss={ep_loss:.5f}  "
+              f"val vel_mse={m['vel_mse']:.5f} ATE={m['ate']:.4f} drift={m['drift']:.2f}%  "
+              f"best_ATE={best_ate:.4f}  {'*' if improved else ''}")
+        if args.patience > 0 and no_imp >= args.patience:
+            print(f"early stopping at epoch {ep+1}")
+            break
+
+    if best_state is not None:
+        model.load_state_dict(best_state)
+    final_metrics = evaluate(model, X_va, POS_va, device, window_seconds, batch_size=args.batch_size)
+    print(f"\nFINAL: vel_mse={final_metrics['vel_mse']:.5f} ATE={final_metrics['ate']:.4f}m "
+          f"drift={final_metrics['drift']:.2f}%")
+
+    torch.save({"model_state_dict": model.state_dict(), "metrics": final_metrics},
+               os.path.join(args.out_dir, "best.pt"))
+    with open(os.path.join(args.out_dir, "metrics.csv"), "w", newline="") as f:
+        w = csv.DictWriter(f, fieldnames=["model", "vel_mse", "ate", "drift"])
+        w.writeheader()
+        w.writerow({"model": "Air-IO", **final_metrics})
+    print(f"saved checkpoint + metrics to {args.out_dir}")
+
+
+if __name__ == "__main__":
+    main()
